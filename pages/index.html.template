<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>MiSnap Web SDK documentation</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta
      name="description"
      content="MiSnap Web SDK - Document and face capture for web browsers"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0" />
    <!-- Same theme as versioned Docsify docs (v*/index.html) -->
    <link rel="stylesheet" href="//cdn.jsdelivr.net/npm/docsify@4/themes/vue.css" />
    <link rel="icon" href="./favicon.png" type="image/png" />
    <style>
      body {
        margin: 0;
        background-color: #fff;
      }
      div#app {
        margin: 0 auto;
        padding-top: 2rem;
        min-height: 100vh;
      }
      .markdown-section {
        box-sizing: border-box;
      }
      .markdown-section ul {
        list-style: none;
      }
      .markdown-section li {
        margin: 0.5rem 0;
      }
      .markdown-section a {
        color: var(--theme-color, #42b983);
        text-decoration: none;
        font-weight: 500;
      }
      .markdown-section a:hover {
        text-decoration: underline;
      }
      .latest {
        margin-left: 0.5rem;
        opacity: 0.85;
        font-size: 0.9em;
      }
    </style>
  </head>
  <body>
    <div id="app">
      <main class="markdown-section" id="main">
        <h1>MiSnap Web SDK documentation</h1>
        <!-- DOCS_VERSION_LIST -->
      </main>
    </div>
  </body>
</html>
